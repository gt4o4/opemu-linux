+/* ---- PCMPGTQ ------------------------------------------------------- */
+void sse42emu_pcmpgtq(uint8_t dst[16], const uint8_t src[16])
+{
+    for (int lane = 0; lane < 2; lane++) {
+        int64_t x, y;
+        memcpy(&x, dst + 8 * lane, 8);
+        memcpy(&y, src + 8 * lane, 8);
+        uint64_t m = (x > y) ? ~0ULL : 0ULL;
+        memcpy(dst + 8 * lane, &m, 8);
+    }
+}
